{
  "name": "almasaeed2010/adminlte",
  "description": "AdminLTE - admin control panel and dashboard that's based on Bootstrap 4",
  "homepage": "https://adminlte.io/",
  "keywords": [
    "css",
    "js",
    "less",
    "responsive",
    "back-end",
    "template",
    "theme",
    "web",
    "admin"
  ],
  "authors": [
    {
      "name": "Colorlib"
    }
  ],
  "license": "MIT",
  "support": {
    "issues": "https://github.com/ColorlibHQ/AdminLTE/issues"
  },
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10.1",
    "yajra/laravel-datatables-oracle": "^12.4",
    "barryvdh/laravel-dompdf": "^3.1",
    "maatwebsite/excel": "^3.1",
    "mpdf/mpdf": "^8.2",
    "razorpay/razorpay": "^2.9",
    "laravel/pulse": "^1.7",
    "laravel/sanctum": "^4.3",
    "spatie/laravel-permission": "^6.25",
    "laravel/horizon": "^5.47",
    "spatie/laravel-query-builder": "^6.4",
    "spatie/laravel-activitylog": "^4.12"
  },
  "require-dev": {
    "laravel/boost": "^1.1",
    "laravel/pail": "^1.2.2",
    "laravel/sail": "^1.41",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5.3",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.24",
    "laravel/breeze": "^2.3",
    "laravel/pint": "^1.13",
    "barryvdh/laravel-debugbar": "^4.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Database\\Factories\\": "database/factories/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php artisan test",
    "pint": "@php vendor/bin/pint",
    "pint:test": "@php vendor/bin/pint --test"
  }
}
