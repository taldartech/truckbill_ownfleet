APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
WEBSITE_URL=https://www.truckbill.in
BLOCK_SEARCH_INDEXING=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

MASTER_ADMIN_NAME="Master Admin"
MASTER_ADMIN_EMAIL=master_admin@truckbill.local
MASTER_ADMIN_PASSWORD=password

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=truckbill
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fleet documents: local folder now, S3 later (same paths in DB)
FLEET_DOCUMENTS_DISK=fleet_documents
# FLEET_DOCUMENTS_DISK=s3_fleet_documents
FLEET_DOCUMENTS_S3_PREFIX=fleet-documents
FLEET_DOCUMENTS_MAX_KB=10240
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=truckbill-fleet
AWS_USE_PATH_STYLE_ENDPOINT=false

DB_BACKUP_DISK=s3
DB_BACKUP_PATH=database-backups
DB_BACKUP_RETENTION_HOURS=24
DB_BACKUP_FAILURE_EMAIL=
DB_BACKUP_SCHEDULE_TIMEZONE=Asia/Kolkata

VITE_APP_NAME="${APP_NAME}"
TDS_PERCENTAGE_DEFAULT=20
TDS_PERCENTAGE_AGENCY=2
TDS_PERCENTAGE_OWNER=1

ONBOARDING_SIGNING_SECRET=
ADMIN_API_URL=https://admin.truckbill.in
RAZORPAY_KEY=
RAZORPAY_SECRET=
